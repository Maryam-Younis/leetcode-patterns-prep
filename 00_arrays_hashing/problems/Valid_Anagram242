class Solution(object):
    def isAnagram(self, s, t):
        """
        :type s: str
        :type t: str
        :rtype: bool
        """
        hashTable = {}

        for char in s:
            if char in hashTable:
                hashTable[char] += 1
            else:
                hashTable[char] = 1

        for char in t:
            if char in hashTable:
                hashTable[char] -= 1
            else:
                return False

        for value in hashTable.values():
            if value != 0:
                return False
        return True